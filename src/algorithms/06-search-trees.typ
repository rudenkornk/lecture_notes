== Splay-деревья

#let tree = tree.with(y-scale: 1)

Splay($x$):
+ $x$ становится корнем.
+ Время работы = $O("depth"(x))$.
+ Амортизированное время работы = $O(log n)$.

#definition[Splay-дерево] — это дерево поиска.
Операция Splay вызывается при вставке, удалении и поиске.

#grid(
  columns: (auto, 1fr),
  column-gutter: 2em,
  [Find($k$)\ #tree((((0, 0), [root]), ((-0.4, -0.5), []), ((0, -1), []), ((-0.4, -1.5), []), ((0, -2), [$k arrow "splay"(k)$])), ((0, 1), (1, 2), (2, 3), (3, 4)))],
  [Работает за $O("depth"(x))$.
    В конце вызывается splay($x$).
    Но так как время для splay также $O("depth"(x))$, то и учётное время поиска как у splay,
    то есть $O(log n)$.],

  [Insert($k$)\ #tree((((0, 0), [root]), ((-0.4, -0.5), []), ((0, -1), []), ((-0.4, -1.5), []), ((0, -2), [$k arrow "splay"(k)$])), ((0, 1), (1, 2), (2, 3), (3, 4)))],
  [Аналогично, $O(log n)$.],
)

Merge($T_1, T_2$).

#grid(
  columns: (1fr, 1fr),
  column-gutter: 1em,
  [$triangle T_1 quad triangle T_2$\
    $forall x in T_1, forall y in T_2: K(x) <= K(y)$],
  [$x$ — максимальный элемент в $T_1$.
    Splay($x$) $=>$ $x$ в корне и у него нет правого потомка.
    Туда и нужно прицепить $T_2$.
    #tree(
      (
        ((0, 0), [$x$]),
        ((-1, -1), [$triangle T_1$]),
        ((1, -1), [$triangle T_2$]),
      ),
      ((0, 1), (0, 2)),
    )],
)

Remove($v$):
$
  #tree((((0, 0), [root]), ((-0.4, -0.5), []), ((0, -1), []), ((-0.4, -1.5), []), ((0, -2), [$v arrow "splay"(v)$])), ((0, 1), (1, 2), (2, 3), (3, 4)))
  arrow #tree((((0, 0), [$v$]), ((-1, -1), [$alpha$]), ((1, -1), [$beta$])), ((0, 1), (0, 2)))
  arrow "merge"(alpha, beta).
$

=== Splay($x$)

1. $x$ — корень $=>$ готово.

2. $z$ — корень.
  #align(center)[$
    #tree((((0, 0), [$z$]), ((-1, -1), [$alpha$]), ((1, -1), [$x$]), ((0.5, -2), [$beta$]), ((1.5, -2), [$gamma$])), ((0, 1), (0, 2), (2, 3), (2, 4)))
    arrow^("zig")
    #tree((((0, 0), [$x$]), ((-1, -1), [$z$]), ((1, -1), [$gamma$]), ((-1.5, -2), [$alpha$]), ((-0.5, -2), [$beta$])), ((0, 1), (0, 2), (1, 3), (1, 4)))
  $]

3. #align(center)[$
    #tree((((0, 0), [$z$]), ((-1, -1), [$alpha$]), ((1, -1), [$y$]), ((0.5, -2), [$beta$]), ((2, -2), [$x$]), ((1.5, -3), [$gamma$]), ((2.5, -3), [$delta$])), ((0, 1), (0, 2), (2, 3), (2, 4), (4, 5), (4, 6)))
    arrow^("zig-zig")
    #tree((((0, 0), [$x$]), ((-1, -1), [$y$]), ((1, -1), [$delta$]), ((-2, -2), [$z$]), ((-0.5, -2), [$gamma$]), ((-2.5, -3), [$alpha$]), ((-1.5, -3), [$beta$])), ((0, 1), (0, 2), (1, 3), (1, 4), (3, 5), (3, 6)))
  $]

  Не то же самое, что zig(zig($x$))!
  Два поворота: сначала $y$, потом $x$!

4. #align(center)[$
    #tree((((0, 0), [$z$]), ((-1, -1), [$y$]), ((1, -1), [$delta$]), ((-1.5, -2), [$alpha$]), ((-0.5, -2), [$x$]), ((-1, -3), [$beta$]), ((0, -3), [$gamma$])), ((0, 1), (0, 2), (1, 3), (1, 4), (4, 5), (4, 6)))
    arrow^("zig-zag")
    #tree((((0, 0), [$x$]), ((-1, -1), [$y$]), ((1, -1), [$z$]), ((-1.5, -2), [$alpha$]), ((-0.5, -2), [$beta$]), ((0.5, -2), [$gamma$]), ((1.5, -2), [$delta$])), ((0, 1), (0, 2), (1, 3), (1, 4), (2, 5), (2, 6)))
  $]

